# Copy to .env.local and fill in. Never commit .env.local.
# Full reference, including risk and rotation notes: documentation/variables.md

# --- Database (Supabase: Settings → Database → Connection string) ----------
# Pooled, used at runtime. Session pooler (5432) — NOT the transaction pooler.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"
# Direct, used by prisma migrate only.
DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# --- Auth (Supabase: Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key — safe to expose to the browser>"
# Server-only, full-bypass credential. Without it, invite emails silently no-op.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# --- LLM --------------------------------------------------------------------
# "anthropic" | "openrouter". Defaults to "anthropic" when unset.
LLM_PROVIDER="openrouter"

# Required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY="sk-ant-..."

# Required when LLM_PROVIDER=openrouter (openrouter.ai → Keys).
# Set a credit limit on the key.
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional. Defaults to meta-llama/llama-3.3-70b-instruct:free — free but
# rate-limited and slow; use a paid model string for live demos.
# OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
# Optional. Override only to point at a proxy or self-hosted OpenAI-compatible
# endpoint.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
